    "DContextProvider": {
      "source": "src/contexts/DContext.tsx",
      "kind": "component",
      "description": "Root context provider for Dynamic UI. Wrap your application with this\ncomponent to configure icons, currency, language, and portal settings\nfor all descendant Dynamic UI components.\n\nTo enable confirmation modals you must also mount `DConfirmModalContainer`\nsomewhere inside this provider (typically right before the closing tag of\nyour root layout), similar to how `DToastContainer` works:\n\n```tsx\n// Default: portalName=\"d-portal\"\n<DContextProvider>\n  <App />\n  <DConfirmModalContainer nodeId=\"d-portal\" />\n</DContextProvider>\n```\n\nIf you customize `portalName`, match it in `DConfirmModalContainer.nodeId`:\n\n```tsx\n// Custom portalName\n<DContextProvider portalName=\"my-custom-portal\">\n  <App />\n  <DConfirmModalContainer nodeId=\"my-custom-portal\" />\n</DContextProvider>\n```",
      "requires": [],
      "signature": "DContextProvider<T extends Record<string, unknown>>({ language?, currency?, icon?, iconRegistry?, iconMap?, breakpoints?, portalName?, availablePortals?, children? }) => JSX.Element",
      "props": {
        "language": {
          "description": "",
          "required": false,
          "type": "string"
        },
        "currency": {
          "description": "",
          "required": false,
          "type": "CurrencyProps"
        },
        "icon": {
          "description": "",
          "required": false,
          "type": "IconProps"
        },
        "iconRegistry": {
          "description": "",
          "required": false,
          "type": "Record<string, IconComponent>"
        },
        "iconMap": {
          "description": "",
          "required": false,
          "type": "IconMapProps"
        },
        "breakpoints": {
          "description": "@deprecated No effect since 2.11.0: breakpoints are read from the --bs-breakpoint-* custom properties",
          "required": false,
          "type": "BreakpointProps"
        },
        "portalName": {
          "description": "DOM element id used as the portal mount point.",
          "required": false,
          "type": "string"
        },
        "availablePortals": {
          "description": "Map of portal name to the component that renders it.",
          "required": false,
          "type": "PortalAvailableList<T>"
        },
        "children": {
          "description": "",
          "required": false,
          "type": "ReactNode"
        }
      },
      "types": {
        "CurrencyProps": {
          "description": "Currency formatting configuration used by `DContextProvider`.",
          "type": "object",
          "fields": {
            "symbol": {
              "type": "string",
              "required": true,
              "description": "Currency symbol (e.g. `\"$\"`, `\"€\"`)."
            },
            "precision": {
              "type": "number",
              "required": true,
              "description": "Number of decimal places (e.g. `2`)."
            },
            "separator": {
              "type": "string",
              "required": true,
              "description": "Thousands separator character (e.g. `\",\"`)."
            },
            "decimal": {
              "type": "string",
              "required": true,
              "description": "Decimal separator character (e.g. `\".\"`)."
            }
          }
        },
        "IconProps": {
          "description": "Icon-font fallback used by `DIcon`. It only applies to icon names that are\nneither registered in `iconRegistry` nor exported by lucide-react: those\nrender as `<i class=\"{familyClass} {familyPrefix}{name}\">`. The default\nfamily is Bootstrap Icons (`\"bi\"` / `\"bi-\"`); Lucide icons do not use it.",
          "type": "object",
          "fields": {
            "familyClass": {
              "type": "string",
              "required": true,
              "description": "CSS class of the icon-font family for fallback icons (default `\"bi\"`)."
            },
            "familyPrefix": {
              "type": "string",
              "required": true,
              "description": "Prefix prepended to the icon name to build its font class (default `\"bi-\"`)."
            },
            "materialStyle": {
              "type": "boolean",
              "required": true,
              "description": "When `true`, string icons skip lucide-react and render as the text of the\nicon-font element (Material Symbols ligatures). Default `false`."
            }
          }
        },
        "IconMapProps": {
          "description": "Icon names that Dynamic UI components use for their built-in icons (close,\nchevrons, alerts, inputs…). Each value is an icon name that `DIcon`\nresolves in order: `iconRegistry`, then a PascalCase lucide-react export,\nthen the icon-font fallback configured in `icon`. The defaults are\nlucide-react names (e.g. `\"X\"`, `\"ChevronDown\"`, `\"AlertTriangle\"`).",
          "type": "object",
          "fields": {
            "x": {
              "type": "string",
              "required": true,
              "description": "Generic close/dismiss icon (default `\"X\"`)."
            },
            "xLg": {
              "type": "string",
              "required": true,
              "description": "Large close/dismiss icon (default `\"X\"`)."
            },
            "chevronDown": {
              "type": "string",
              "required": true,
              "description": "Chevron-down icon (default `\"ChevronDown\"`)."
            },
            "chevronUp": {
              "type": "string",
              "required": true,
