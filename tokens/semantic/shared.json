{
  "$description": "Semantic tokens that do not vary by colour mode: type roles, radius roles, elevation and motion roles. Loaded into every mode of the Semantic collection.",
  "ramp": {
    "$type": "color",
    "$description": "Palette steps, reached through the role that owns them. `role.primary.base` says what a colour is FOR; `ramp.primary.500` says WHERE it sits on its scale — a template author composing a page needs both, and only the first existed. Defined here rather than in the mode files because a step is the same step in either theme: `ramp.primary.100` is a light blue on a dark page too. The role tokens are what flip. `inverse` has no entry: it is neutral-900 in light and neutral-25 in dark, so a numbered step has no stable meaning for it.",
    "primary": { "25": { "$value": "{color.blue.25}" }, "50": { "$value": "{color.blue.50}" }, "100": { "$value": "{color.blue.100}" }, "200": { "$value": "{color.blue.200}" }, "300": { "$value": "{color.blue.300}" }, "400": { "$value": "{color.blue.400}" }, "500": { "$value": "{color.blue.500}" }, "600": { "$value": "{color.blue.600}" }, "700": { "$value": "{color.blue.700}" }, "800": { "$value": "{color.blue.800}" }, "900": { "$value": "{color.blue.900}" } },
    "secondary": { "25": { "$value": "{color.neutral.25}" }, "50": { "$value": "{color.neutral.50}" }, "100": { "$value": "{color.neutral.100}" }, "200": { "$value": "{color.neutral.200}" }, "300": { "$value": "{color.neutral.300}" }, "400": { "$value": "{color.neutral.400}" }, "500": { "$value": "{color.neutral.500}" }, "600": { "$value": "{color.neutral.600}" }, "700": { "$value": "{color.neutral.700}" }, "800": { "$value": "{color.neutral.800}" }, "900": { "$value": "{color.neutral.900}" } },
    "success": { "25": { "$value": "{color.green.25}" }, "50": { "$value": "{color.green.50}" }, "100": { "$value": "{color.green.100}" }, "200": { "$value": "{color.green.200}" }, "300": { "$value": "{color.green.300}" }, "400": { "$value": "{color.green.400}" }, "500": { "$value": "{color.green.500}" }, "600": { "$value": "{color.green.600}" }, "700": { "$value": "{color.green.700}" }, "800": { "$value": "{color.green.800}" }, "900": { "$value": "{color.green.900}" } },
    "info": { "25": { "$value": "{color.cyan.25}" }, "50": { "$value": "{color.cyan.50}" }, "100": { "$value": "{color.cyan.100}" }, "200": { "$value": "{color.cyan.200}" }, "300": { "$value": "{color.cyan.300}" }, "400": { "$value": "{color.cyan.400}" }, "500": { "$value": "{color.cyan.500}" }, "600": { "$value": "{color.cyan.600}" }, "700": { "$value": "{color.cyan.700}" }, "800": { "$value": "{color.cyan.800}" }, "900": { "$value": "{color.cyan.900}" } },
    "warning": { "25": { "$value": "{color.yellow.25}" }, "50": { "$value": "{color.yellow.50}" }, "100": { "$value": "{color.yellow.100}" }, "200": { "$value": "{color.yellow.200}" }, "300": { "$value": "{color.yellow.300}" }, "400": { "$value": "{color.yellow.400}" }, "500": { "$value": "{color.yellow.500}" }, "600": { "$value": "{color.yellow.600}" }, "700": { "$value": "{color.yellow.700}" }, "800": { "$value": "{color.yellow.800}" }, "900": { "$value": "{color.yellow.900}" } },
    "danger": { "25": { "$value": "{color.red.25}" }, "50": { "$value": "{color.red.50}" }, "100": { "$value": "{color.red.100}" }, "200": { "$value": "{color.red.200}" }, "300": { "$value": "{color.red.300}" }, "400": { "$value": "{color.red.400}" }, "500": { "$value": "{color.red.500}" }, "600": { "$value": "{color.red.600}" }, "700": { "$value": "{color.red.700}" }, "800": { "$value": "{color.red.800}" }, "900": { "$value": "{color.red.900}" } },
    "neutral": { "25": { "$value": "{color.neutral.25}" }, "50": { "$value": "{color.neutral.50}" }, "100": { "$value": "{color.neutral.100}" }, "200": { "$value": "{color.neutral.200}" }, "300": { "$value": "{color.neutral.300}" }, "400": { "$value": "{color.neutral.400}" }, "500": { "$value": "{color.neutral.500}" }, "600": { "$value": "{color.neutral.600}" }, "700": { "$value": "{color.neutral.700}" }, "800": { "$value": "{color.neutral.800}" }, "900": { "$value": "{color.neutral.900}" } }
  },
  "text": {
    "$description": "Type roles. 2.x expressed these as `$h1-font-size` .. `$h6-font-size` plus `$display1..6`, each wired through rfs() fluid sizing. Fluid sizing cannot round-trip to Figma, so the sizes here are discrete; responsive scaling belongs in the Breakpoint collection.",
    "body": {
      "$description": "Running text. `margin-block-end` is what makes a paragraph a paragraph in a CMS body: the reset zeroes browser defaults because component chrome spaces itself with `gap`, and this token puts the rhythm back on the element, where a design handoff expects to find it.",
      "font-family": { "$type": "fontFamily", "$value": "{font-family.sans}" },
      "margin-block-end": { "$type": "dimension", "$value": "{size.4}" },
      "font-size": { "$type": "dimension", "$value": "{font-size.300}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font-weight.normal}" },
      "line-height": { "$type": "number", "$value": "{line-height.normal}" }
    },
    "body-sm": {
      "font-size": { "$type": "dimension", "$value": "{font-size.200}" },
      "line-height": { "$type": "number", "$value": "{line-height.normal}" }
    },
    "body-xs": {
      "$description": "The rung below `body-sm`. Named for its SIZE, like the two above it, because that is how it is reached for — it was `caption`, which named a purpose and broke a series otherwise made of sizes, so a client looking for the step below small found a word about photo captions instead. Tighter leading than body, which is what 12px wants.",
      "font-size": { "$type": "dimension", "$value": "{font-size.100}" },
      "line-height": { "$type": "number", "$value": "{line-height.snug}" }
    },
    "heading": {
      "$description": "Shared across h1-h6. 2.x used $font-weight-bold, whose value was 600 — the token named `semibold` here, so the rendered weight is unchanged. More room above than below, because a heading opens a section and belongs with the text it introduces; adjacent margins collapse, so a heading after a paragraph takes the larger of the two rather than their sum.",
      "font-family": { "$type": "fontFamily", "$value": "{font-family.sans}" },
      "margin-block-start": { "$type": "dimension", "$value": "{size.7}" },
      "margin-block-end": { "$type": "dimension", "$value": "{size.2}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font-weight.semibold}" },
      "line-height": { "$type": "number", "$value": "{line-height.tight}" }
    },
    "heading-1": { "font-size": { "$type": "dimension", "$value": "{font-size.900}" } },
    "heading-2": { "font-size": { "$type": "dimension", "$value": "{font-size.800}" } },
    "heading-3": { "font-size": { "$type": "dimension", "$value": "{font-size.700}" } },
    "heading-4": { "font-size": { "$type": "dimension", "$value": "{font-size.600}" } },
    "heading-5": { "font-size": { "$type": "dimension", "$value": "{font-size.500}" } },
    "heading-6": { "font-size": { "$type": "dimension", "$value": "{font-size.300}" } },
    "display-1": { "font-size": { "$type": "dimension", "$value": "{font-size.1500}" } },
    "display-2": { "font-size": { "$type": "dimension", "$value": "{font-size.1400}" } },
    "display-3": { "font-size": { "$type": "dimension", "$value": "{font-size.1300}" } },
    "display-4": { "font-size": { "$type": "dimension", "$value": "{font-size.1200}" } },
    "display-5": { "font-size": { "$type": "dimension", "$value": "{font-size.1100}" } },
    "display-6": { "font-size": { "$type": "dimension", "$value": "{font-size.1000}" } },
    "legend": {
      "$description": "A fieldset caption. 2.x set these in `_shame.scss`, inside `@media (min-width: 1200px)` — not a design decision but the only way to override Bootstrap, whose own legend rule lived in that media query because rfs scaled it fluidly below. There is no rfs here, so the values are discrete and apply at every width, which is the whole of the design rather than its top half.",
      "font-size": { "$type": "dimension", "$value": "{font-size.500}" },
      "line-height": { "$type": "number", "$value": "{line-height.none}" },
      "margin-block-end": { "$type": "dimension", "$value": "{size.4}" }
    },
    "list": {
      "$description": "Lists in running text. Items sit closer together than paragraphs do, because a list is one thought broken up rather than several.",
      "item-margin-block-start": { "$type": "dimension", "$value": "{size.2}" },
      "nested-margin-block": { "$type": "dimension", "$value": "{size.2}" }
    },
    "label": {
      "font-size": { "$type": "dimension", "$value": "{font-size.300}" },
      "font-weight": { "$type": "fontWeight", "$value": "{font-weight.normal}" }
    },
    "table-header": {
      "$description": "2.x forced this with `th { font-weight: var(--bs-fw-semibold) !important }` in _shame.scss. Its 500 is the token named `medium` here.",
      "font-weight": { "$type": "fontWeight", "$value": "{font-weight.medium}" }
    }
  },
  "shape": {
    "$type": "dimension",
    "$description": "Radius roles. Named `shape` rather than `radius` so the role names cannot collide with the primitive `radius.*` scale — two collections declaring `radius.none` would emit one custom property twice, the second aliasing itself.",
    "control": { "$value": "{radius.md}", "$description": "Buttons, inputs, chips." },
    "control-sm": { "$value": "{radius.sm}" },
    "control-lg": { "$value": "{radius.lg}" },
    "surface": { "$value": "{radius.lg}", "$description": "Cards, panels." },
    "surface-lg": { "$value": "{radius.xl}", "$description": "Modals, offcanvas." },
    "pill": { "$value": "{radius.pill}" },
    "none": { "$value": "{radius.none}" }
  },
  "stroke": {
    "$type": "dimension",
    "$description": "Border-width roles. Named `stroke` for the same reason `shape` is not `radius`.",
    "control": { "$value": "{border-width.1}" },
    "divider": { "$value": "{border-width.1}" },
    "emphasis": { "$value": "{border-width.2}" }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": "{opacity.65}" },
    "muted": { "$value": "{opacity.50}" },
    "scrim": { "$value": "{opacity.50}" }
  },
  "focus": {
    "ring-width": { "$type": "dimension", "$value": "{border-width.3}" },
    "ring-offset": { "$type": "dimension", "$value": "{border-width.1}" }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Composite shadows. Figma has no shadow VARIABLE type — shadows are effect styles — so this group is not published as variables; the Figma exporter emits it as effect styles instead.",
    "$extensions": {
      "dev.dynamicframework.figma": { "publish": false, "exportAs": "effectStyle" }
    },
    "none": {
      "$value": {
        "color": "{color.alpha.black.5}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" }
      }
    },
    "sm": {
      "$value": {
        "color": "{color.alpha.black.5}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$value": {
        "color": "{color.alpha.black.10}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 8, "unit": "px" }, "spread": { "value": -2, "unit": "px" }
      }
    },
    "lg": {
      "$value": {
        "color": "{color.alpha.black.10}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 10, "unit": "px" }, "blur": { "value": 20, "unit": "px" }, "spread": { "value": -4, "unit": "px" }
      }
    },
    "xl": {
      "$value": {
        "color": "{color.alpha.black.20}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 20, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": -8, "unit": "px" }
      }
    }
  },
  "motion": {
    "$description": "Motion roles.",
    "$extensions": {
      "dev.dynamicframework.figma": { "publish": false }
    },
    "duration-enter": { "$type": "duration", "$value": "{duration.normal}" },
    "duration-exit": { "$type": "duration", "$value": "{duration.fast}" },
    "duration-hover": { "$type": "duration", "$value": "{duration.fast}" },
    "easing-enter": { "$type": "cubicBezier", "$value": "{easing.decelerate}" },
    "easing-exit": { "$type": "cubicBezier", "$value": "{easing.accelerate}" },
    "easing-standard": { "$type": "cubicBezier", "$value": "{easing.standard}" }
  }
}
