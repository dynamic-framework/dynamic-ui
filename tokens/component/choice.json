{
  "$description": "Checkbox, radio and switch. One token set because they are the same control with a different shape — 2.x split them across `form-check`, `form-switch` and `form-check-input`, which meant the sizes drifted apart. One ACCENT per validity state rather than a separate border colour for checked, hover, valid and invalid: the four had to be kept in step by hand, and a checked-and-invalid control ended up filled with the checked colour and outlined in the invalid one.",
  "choice": {
    "size": {"$type": "dimension", "$value": "{size.5}"},
    "gap": {"$type": "dimension", "$value": "{size.2}"},
    "radius": {"$type": "dimension", "$value": "{shape.control-sm}"},
    "border-width": {"$type": "dimension", "$value": "{stroke.control}"},

    "bg": {"$type": "color", "$value": "{color.transparent}"},
    "border-color": {"$type": "color", "$value": "{border.strong}"},

    "accent": {"$type": "color", "$value": "{role.primary.base}"},
    "accent-invalid": {"$type": "color", "$value": "{role.danger.base}"},
    "accent-valid": {"$type": "color", "$value": "{role.success.base}"},

    "disabled-border-color": {"$type": "color", "$value": "{border.disabled}"},
    "disabled-opacity": {"$type": "number", "$value": "{opacity.disabled}"},


    "switch-width": {"$type": "dimension", "$value": "{size.9}"},
    "switch-height": {"$type": "dimension", "$value": "{size.5}"},
    "switch-thumb-inset": {"$type": "dimension", "$value": "{border-width.2}"},
    "switch-thumb-color": {"$type": "color", "$value": "{bg.surface}"},
    "switch-track-color": {"$type": "color", "$value": "{border.strong}"}
  }
}
