{
  "$description": "Range input tokens. The filled portion is drawn with a gradient whose stop is a custom property the component writes, so there is no second element to size.",
  "range": {
    "track-height": {"$type": "dimension", "$value": "{size.2}"},
    "track-radius": {"$type": "dimension", "$value": "{shape.pill}"},
    "track-color": {"$type": "color", "$value": "{bg.sunken}"},
    "fill-color": {"$type": "color", "$value": "{role.primary.base}"},
    "thumb-size": {"$type": "dimension", "$value": "{size.5}"},
    "thumb-color": {"$type": "color", "$value": "{role.primary.base}"},
    "thumb-border-color": {"$type": "color", "$value": "{bg.surface}"},
    "thumb-border-width": {"$type": "dimension", "$value": "{border-width.2}"},
    "disabled-fill-color": {"$type": "color", "$value": "{border.strong}"},
    "value-font-size": {"$type": "dimension", "$value": "{font-size.200}"},
    "value-color": {"$type": "color", "$value": "{fg.muted}"}
  }
}
