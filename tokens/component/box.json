{
  "$description": "Box tokens — a bare surface with padding and elevation.",
  "box": {
    "padding": {"$type": "dimension", "$value": "{size.4}"},
    "radius": {"$type": "dimension", "$value": "{shape.control}"},
    "bg": {"$type": "color", "$value": "{bg.surface}"},
    "fg": {"$type": "color", "$value": "{fg.default}"},
    "border-color": {"$type": "color", "$value": "{border.default}"},
    "shadow": {"$type": "shadow", "$value": "{elevation.sm}"}
  }
}
