{
  "$description": "Password strength meter tokens. The bar is its own block rather than a reskinned progress: it is thinner, has no label, and its colour comes from a strength tier instead of a role prop.",
  "password-strength": {
    "bar-height": {"$type": "dimension", "$value": "{size.2}"},
    "bar-radius": {"$type": "dimension", "$value": "{shape.pill}"},
    "bar-track-color": {"$type": "color", "$value": "{bg.sunken}"},
    "gap": {"$type": "dimension", "$value": "{size.2}"},
    "check-gap": {"$type": "dimension", "$value": "{size.2}"},
    "check-font-size": {"$type": "dimension", "$value": "{font-size.200}"},
    "check-color": {"$type": "color", "$value": "{fg.muted}"},
    "check-icon-color": {"$type": "color", "$value": "{fg.subtle}"},
    "check-met-color": {"$type": "color", "$value": "{role.success.emphasis}"},
    "duration": {"$type": "duration", "$value": "{duration.slow}"}
  }
}
