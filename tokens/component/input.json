{
  "$description": "Input component tokens. Unlike button, an input's colours are not a variant matrix — there is one appearance plus a few states — so the colour tokens do belong here.",
  "input": {
    "padding-block": { "$type": "dimension", "$value": "{size.2}" },
    "padding-inline": { "$type": "dimension", "$value": "{size.3}" },
    "font-family": { "$type": "fontFamily", "$value": "{font-family.sans}" },
    "font-size": { "$type": "dimension", "$value": "{font-size.300}" },
    "line-height": { "$type": "number", "$value": "{line-height.normal}" },
    "radius": { "$type": "dimension", "$value": "{shape.control-sm}" },
    "border-width": { "$type": "dimension", "$value": "{stroke.control}" },

    "bg": { "$type": "color", "$value": "{bg.surface}" },
    "fg": { "$type": "color", "$value": "{fg.default}" },
    "border-color": { "$type": "color", "$value": "{border.default}" },
    "placeholder-color": {
      "$type": "color",
      "$value": "{fg.muted}",
      "$description": "2.x aliased the placeholder to $border-color (gray-100), which gives a 1.3:1 ratio against a white field — well under the 4.5:1 WCAG minimum for text. Moved to fg.muted (4.9:1)."
    },

    "hover-border-color": { "$type": "color", "$value": "{border.strong}" },
    "focus-border-color": { "$type": "color", "$value": "{role.primary.base}" },

    "invalid-border-color": { "$type": "color", "$value": "{role.danger.base}" },
    "invalid-fg": { "$type": "color", "$value": "{role.danger.emphasis}" },
    "valid-border-color": { "$type": "color", "$value": "{role.success.base}" },
    "valid-fg": { "$type": "color", "$value": "{role.success.emphasis}" },

    "disabled-bg": { "$type": "color", "$value": "{bg.disabled}" },
    "disabled-fg": { "$type": "color", "$value": "{fg.disabled}" },
    "disabled-border-color": { "$type": "color", "$value": "{border.disabled}" },

    "sm": {
      "padding-block": { "$type": "dimension", "$value": "{size.1}" },
      "padding-inline": { "$type": "dimension", "$value": "{size.2}" },
      "font-size": { "$type": "dimension", "$value": "{font-size.200}" }
    },
    "lg": {
      "$description": "2.x set the large font size to var(--bs-ref-spacer-5) — a spacing token used as a font size. Replaced with the type-scale step of the same value (20px).",
      "padding-block": { "$type": "dimension", "$value": "{size.4}" },
      "padding-inline": { "$type": "dimension", "$value": "{size.4}" },
      "font-size": { "$type": "dimension", "$value": "{font-size.500}" }
    },

    "help": {
      "margin-block-start": { "$type": "dimension", "$value": "{size.1}" },
      "font-size": { "$type": "dimension", "$value": "{font-size.200}" },
      "color": {
        "$type": "color",
        "$value": "{fg.muted}",
        "$description": "2.x used gray-400 here (3.5:1) and then forced gray-500 through _shame.scss with !important. Both paths now resolve to the same token."
      }
    }
  }
}
