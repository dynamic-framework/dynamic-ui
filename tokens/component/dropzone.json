{
  "$description": "File dropzone tokens (DBoxFile). Named `dropzone` rather than `box-file` because the block is a drop target, and because `box-file` would read as a variant of `box`, which it is not.",
  "dropzone": {
    "padding": {"$type": "dimension", "$value": "{size.6}"},
    "gap": {"$type": "dimension", "$value": "{size.3}"},
    "radius": {"$type": "dimension", "$value": "{shape.control}"},
    "border-width": {"$type": "dimension", "$value": "{stroke.emphasis}"},
    "bg": {"$type": "color", "$value": "{bg.surface}"},
    "fg": {"$type": "color", "$value": "{fg.muted}"},
    "border-color": {"$type": "color", "$value": "{border.strong}"},
    "hover-bg": {"$type": "color", "$value": "{bg.muted}"},
    "hover-border-color": {"$type": "color", "$value": "{role.primary.base}"},
    "invalid-border-color": {"$type": "color", "$value": "{role.danger.base}"},
    "valid-border-color": {"$type": "color", "$value": "{role.success.base}"},
    "disabled-bg": {"$type": "color", "$value": "{bg.disabled}"},
    "disabled-fg": {"$type": "color", "$value": "{fg.disabled}"},
    "file-gap": {"$type": "dimension", "$value": "{size.2}"},
    "file-padding-block": {"$type": "dimension", "$value": "{size.2}"}
  }
}
