{
  "$description": "Data table tokens.",
  "table": {
    "padding-block": {"$type": "dimension", "$value": "{size.3}"},
    "padding-inline": {"$type": "dimension", "$value": "{size.4}"},
    "padding-block-sm": {"$type": "dimension", "$value": "{size.2}"},
    "padding-inline-sm": {"$type": "dimension", "$value": "{size.3}"},
    "border-width": {"$type": "dimension", "$value": "{stroke.divider}"},
    "font-size": {"$type": "dimension", "$value": "{font-size.300}"},
    "head-font-size": {"$type": "dimension", "$value": "{font-size.200}"},

    "bg": {"$type": "color", "$value": "{bg.surface}"},
    "fg": {"$type": "color", "$value": "{fg.default}"},
    "border-color": {"$type": "color", "$value": "{border.default}"},
    "head-fg": {"$type": "color", "$value": "{fg.muted}"},
    "head-bg": {"$type": "color", "$value": "{bg.muted}"},
    "stripe-bg": {"$type": "color", "$value": "{bg.sunken}"},
    "hover-bg": {"$type": "color", "$value": "{bg.muted}"},
    "active-bg": {"$type": "color", "$value": "{role.primary.subtle}"}
  }
}
