{
  "$description": "Avatar tokens. The size scale is the 2.x one (spacer 8/10/12/14/16/18 = 32 to 72px); the glyph size derives from it in CSS so a custom size stays proportional.",
  "avatar": {
    "size": {"$type": "dimension", "$value": "{size.12}"},
    "size-xs": {"$type": "dimension", "$value": "{size.8}"},
    "size-sm": {"$type": "dimension", "$value": "{size.10}"},
    "size-lg": {"$type": "dimension", "$value": "{size.14}"},
    "size-xl": {"$type": "dimension", "$value": "{size.16}"},
    "size-xxl": {"$type": "dimension", "$value": "{size.18}"},
    "radius": {"$type": "dimension", "$value": "{shape.pill}"},
    "border-width": {"$type": "dimension", "$value": "{stroke.control}"},
    "bg": {"$type": "color", "$value": "{bg.muted}"},
    "fg": {"$type": "color", "$value": "{fg.muted}"},
    "border-color": {"$type": "color", "$value": "{bg.surface}"},
    "font-weight": {"$type": "fontWeight", "$value": "{font-weight.semibold}"}
  }
}
