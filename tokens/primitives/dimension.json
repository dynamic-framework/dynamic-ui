{
  "$description": "Dimension primitives. Authored by hand. Values are in px because px is the unit Figma works in; the CSS emitter converts the groups marked `unit: rem` using the root font size.",
  "size": {
    "$type": "dimension",
    "$description": "The 4px spacing scale. Step N is N*4px, preserving the 2.x `$spacer-N` scale so the spacing utilities keep their meaning.",
    "$extensions": {"dev.dynamicframework.css": {"unit": "rem"}},
    "0": {"$value": {"value": 0, "unit": "px"}},
    "1": {"$value": {"value": 4, "unit": "px"}},
    "2": {"$value": {"value": 8, "unit": "px"}},
    "3": {"$value": {"value": 12, "unit": "px"}},
    "4": {"$value": {"value": 16, "unit": "px"}},
    "5": {"$value": {"value": 20, "unit": "px"}},
    "6": {"$value": {"value": 24, "unit": "px"}},
    "7": {"$value": {"value": 28, "unit": "px"}},
    "8": {"$value": {"value": 32, "unit": "px"}},
    "9": {"$value": {"value": 36, "unit": "px"}},
    "10": {"$value": {"value": 40, "unit": "px"}},
    "11": {"$value": {"value": 44, "unit": "px"}},
    "12": {"$value": {"value": 48, "unit": "px"}},
    "13": {"$value": {"value": 52, "unit": "px"}},
    "14": {"$value": {"value": 56, "unit": "px"}},
    "15": {"$value": {"value": 60, "unit": "px"}},
    "16": {"$value": {"value": 64, "unit": "px"}},
    "17": {"$value": {"value": 68, "unit": "px"}},
    "18": {"$value": {"value": 72, "unit": "px"}},
    "19": {"$value": {"value": 76, "unit": "px"}},
    "20": {"$value": {"value": 80, "unit": "px"}},
    "21": {"$value": {"value": 84, "unit": "px"}},
    "22": {"$value": {"value": 88, "unit": "px"}},
    "23": {"$value": {"value": 92, "unit": "px"}},
    "24": {"$value": {"value": 96, "unit": "px"}},
    "25": {"$value": {"value": 100, "unit": "px"}},
    "26": {"$value": {"value": 104, "unit": "px"}},
    "27": {"$value": {"value": 108, "unit": "px"}},
    "28": {"$value": {"value": 112, "unit": "px"}},
    "29": {"$value": {"value": 116, "unit": "px"}},
    "30": {"$value": {"value": 120, "unit": "px"}}
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radii. Values match the 2.x `$border-radius-*` scale.",
    "none": {"$value": {"value": 0, "unit": "px"}},
    "sm": {"$value": {"value": 4, "unit": "px"}},
    "md": {"$value": {"value": 8, "unit": "px"}},
    "lg": {"$value": {"value": 16, "unit": "px"}},
    "xl": {"$value": {"value": 24, "unit": "px"}},
    "2xl": {"$value": {"value": 32, "unit": "px"}},
    "pill": {"$value": {"value": 9999, "unit": "px"}, "$description": "Effectively infinite. Replaces the 2.x 50rem trick."}
  },
  "border-width": {
    "$type": "dimension",
    "$description": "Border widths. 2.x expressed 2-6 as calc() multiples of a single width; here each is a literal, because a token must be a literal or an alias, never an expression.",
    "0": {"$value": {"value": 0, "unit": "px"}},
    "1": {"$value": {"value": 1, "unit": "px"}},
    "2": {"$value": {"value": 2, "unit": "px"}},
    "3": {"$value": {"value": 3, "unit": "px"}},
    "4": {"$value": {"value": 4, "unit": "px"}},
    "5": {"$value": {"value": 5, "unit": "px"}},
    "6": {"$value": {"value": 6, "unit": "px"}}
  },
  "container": {
    "$description": "Page container max-widths. Separate from `measure`, which sizes a component, and from `breakpoint`, which is where the layout changes.",
    "sm": {"$type": "dimension", "$value": "540px"},
    "md": {"$type": "dimension", "$value": "720px"},
    "lg": {"$type": "dimension", "$value": "960px"},
    "xl": {"$type": "dimension", "$value": "1140px"},
    "xxl": {"$type": "dimension", "$value": "1320px"}
  },

  "measure": {
    "$type": "dimension",
    "$description": "Component widths. Separate from the `size` spacing scale on purpose: a dropdown's min-width and a toast's width are dimensions, not spacing, and reaching into the 4px scale for them meant either an absurd value (a 120px toast) or a literal. Named rather than numbered, because there is no useful arithmetic between them.",
    "2xs": {"$value": {"value": 120, "unit": "px"}},
    "xs": {"$value": {"value": 160, "unit": "px"}},
    "sm": {"$value": {"value": 240, "unit": "px"}},
    "md": {"$value": {"value": 320, "unit": "px"}},
    "lg": {"$value": {"value": 480, "unit": "px"}},
    "xl": {"$value": {"value": 640, "unit": "px"}},
    "2xl": {"$value": {"value": 800, "unit": "px"}}
  },
  "breakpoint": {
    "$type": "dimension",
    "$extensions": {"dev.dynamicframework.css": {"keepZeroUnit": true}},
    "$description": "Viewport breakpoints. Values and names match the 2.x tiers (xs..xxl) because DContextProvider takes those names as a public API, and DContext reads these custom properties at runtime to resolve every responsive prop. Emitted in px and never converted to rem: a media query must not depend on the root font size.",
    "xs": {"$value": {"value": 0, "unit": "px"}},
    "sm": {"$value": {"value": 576, "unit": "px"}},
    "md": {"$value": {"value": 768, "unit": "px"}},
    "lg": {"$value": {"value": 992, "unit": "px"}},
    "xl": {"$value": {"value": 1200, "unit": "px"}},
    "xxl": {"$value": {"value": 1400, "unit": "px"}}
  }
}
