{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../stories/**/*.ts",
    "../stories/**/*.tsx",
  ]
}