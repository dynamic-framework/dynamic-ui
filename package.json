{
  "name": "@dynamic-framework/ui-react",
  "sideEffects": [
    "*.css",
    "./dist/vanilla/*",
    "./src/vanilla/*"
  ],
  "version": "2.6.0",
  "description": "React Dynamic Framework",
  "license": "https://github.com/dynamic-framework/dynamic-ui/blob/master/LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamic-framework/dynamic-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/dynamic-framework/dynamic-ui.git"
  },
  "author": {
    "name": "Dynamic Framework Team",
    "email": "support@modyo.com",
    "url": "https://dynamicframework.dev"
  },
  "contributors": [
    {
      "name": "Abraham José González Barboza",
      "email": "agonzalez@modyo.com",
      "url": "https://github.com/abe-modyo"
    },
    {
      "name": "Eduard Fabián Barón Gutiérrez",
      "email": "ebaron@modyo.com",
      "url": "https://github.com/efbarong"
    },
    {
      "name": "Johann Felipe Rojas Pineda",
      "email": "jrojas@modyo.com",
      "url": "https://github.com/johannrp27"
    }
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:storybook": "test-storybook",
    "build": "npm run clean && npm run build:react && npm run css && npm run build:vanilla",
    "build:react": "tsc -p ./tsconfig.build.json && rollup -c rollup.config.mjs",
    "build:react:watch": "tsc -p ./tsconfig.build.json && rollup -c rollup.config.mjs",
    "dev:ts": "tsc -p tsconfig.build.json",
    "dev:rollup": "rollup -c rollup.config.mjs",
    "build:once": "npm run dev:ts && npm run dev:rollup && npm run css && yalc push",
    "watch:ds": "npx nodemon --watch src --watch tokens --ext ts,tsx,css,json --delay 1000ms --exec \"npm run build:once\"",
    "clean": "rimraf dist-transpiled && rimraf dist",
    "compile": "tsc -p . && rollup -c rollup.config.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --docs -o docs",
    "generate:registry": "node scripts/generate-api.mjs && node scripts/generate-schema.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "tokens": "npm run tokens:primitives && npm run tokens:verify && npm run tokens:validate && npm run tokens:build && npm run storybook:theme",
    "tokens:primitives": "node scripts/tokens/build-primitives.mjs",
    "tokens:build": "node scripts/tokens/build.mjs",
    "tokens:validate": "node scripts/tokens/validate.mjs",
    "tokens:verify": "node scripts/tokens/verify.mjs",
    "tokens:figma:push": "node scripts/tokens/figma-push.mjs",
    "tokens:figma:pull": "node scripts/tokens/figma-pull.mjs",
    "css": "npm run tokens && npm run css:build && npm run tokens:orphans && npm run css:validate && npm run css:verify && npm run css:consistency && npm run css:usage && npm run css:attributes && npm run css:flow",
    "css:build": "node scripts/css/build.mjs",
    "css:validate": "node scripts/css/validate.mjs",
    "css:verify": "node scripts/css/verify.mjs",
    "css:consistency": "node scripts/css/consistency.mjs",
    "css:audit": "node scripts/css/audit.mjs",
    "eslint": "npm run eslint:src && npm run eslint:stories && npm run eslint:test",
    "eslint:src": "eslint 'src/**/*.ts' 'src/**/*.tsx' --ignore-pattern '**/*.spec.tsx'",
    "eslint:stories": "eslint 'stories/**/*.stories.tsx' 'stories/**/*.tsx'",
    "eslint:test": "eslint 'src/**/*.spec.tsx' 'src/**/*.spec.ts'",
    "stylelint": "stylelint '**/*.css' '**/*.scss' --rd",
    "publish:cdn": "npm run publish:cdn-version && npm run publish:cdn-latest",
    "publish:cdn-version": "node scripts/publish-cdn.js",
    "publish:cdn-latest": "aws s3 sync ./dist/ s3://dynamicframework-cdn/assets/latest/ui-react --delete --exclude 'api.json' --acl public-read",
    "publish:cdn-rc": "aws s3 sync ./dist/ s3://dynamicframework-cdn/assets/rc/ui-react --delete --acl public-read",
    "publish:cdn-dev": "aws s3 sync ./dist/ s3://dynamicframework-cdn/assets/dev/ui-react --delete --acl public-read",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "verify": "node scripts/verify.js",
    "axe": "npx tsx scripts/generate-a11y-report.ts",
    "css:usage": "node scripts/css/usage.mjs",
    "css:migrate": "node scripts/css/migrate-classes.mjs && node scripts/css/migrate-components.mjs && node scripts/css/migrate-variables.mjs",
    "css:docs": "node scripts/css/migrate-docs-tables.mjs",
    "build:vanilla": "node scripts/build-vanilla.mjs",
    "css:attributes": "node scripts/css/attributes.mjs",
    "typecheck:stories": "node scripts/typecheck-stories.mjs",
    "tokens:orphans": "node scripts/tokens/orphans.mjs",
    "css:flow": "node scripts/css/flow.mjs",
    "css:generated": "node scripts/css/generated.mjs",
    "icons": "node scripts/icons/sprite.mjs",
    "stories:snippets": "node scripts/stories/check-snippets.mjs",
    "stories:actions": "node scripts/stories/check-event-actions.mjs",
    "storybook:theme": "node scripts/storybook/build-manager-theme.mjs",
    "storybook:hooks": "node scripts/storybook/check-preview-hooks.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/",
    "jest/",
    "tokens/"
  ],
  "dependencies": {
    "@floating-ui/react": "~0.27.16",
    "@react-input/mask": "~2.0.4",
    "classnames": "~2.5.1",
    "currency.js": "~2.0.4",
    "date-fns": "~4.1.0",
    "file-selector": "~2.1.2",
    "google-libphonenumber": "~3.2.43",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.553.0",
    "react-error-boundary": "^6.1.0",
    "react-international-phone": "~4.6.0",
    "react-is": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@commitlint/cli": "~19.3.0",
    "@commitlint/config-conventional": "~19.2.2",
    "@mdx-js/react": "~2.3.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@storybook/addon-a11y": "~10.2.8",
    "@storybook/addon-docs": "~10.2.8",
    "@storybook/addon-links": "~10.2.8",
    "@storybook/react-vite": "~10.2.8",
    "@testing-library/jest-dom": "~6.6.3",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/google-libphonenumber": "~7.4.30",
    "@types/jest": "~29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-is": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "~6.9.0",
    "@typescript-eslint/parser": "~6.9.0",
    "@vitejs/plugin-react": "~4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "~10.4.16",
    "axe-playwright": "~1.2.3",
    "conventional-changelog-conventionalcommits": "~6.1.0",
    "eslint": "~8.52.0",
    "eslint-config-airbnb": "~19.0.4",
    "eslint-config-airbnb-typescript": "~17.1.0",
    "eslint-plugin-import": "~2.29.0",
    "eslint-plugin-jsx-a11y": "~6.7.1",
    "eslint-plugin-react": "~7.33.2",
    "eslint-plugin-react-hooks": "~4.6.0",
    "formik": "~2.4.8",
    "husky": "~9.1.7",
    "i18next": "~25.6.1",
    "jest": "^30.3.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^15.2.10",
    "playwright": "^1.58.2",
    "postcss-cli": "~10.1.0",
    "react": "~19.2.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "~19.2.1",
    "react-i18next": "~16.2.4",
    "recharts": "~3.3.0",
    "remark-gfm": "~4.0.1",
    "rimraf": "~6.1.0",
    "rollup": "^4.59.0",
    "sass": "~1.69.4",
    "storybook": "^10.2.8",
    "stylelint": "^16.16.0",
    "stylelint-config-twbs-bootstrap": "^16.0.0",
    "ts-jest": "^29.4.6",
    "tslib": "~2.6.2",
    "tsx": "^4.21.0",
    "typescript": "~5.2.2",
    "vite": "^6.4.1",
    "yup": "^1.6.1"
  },
  "peerDependencies": {
    "i18next": ">=25 <26",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "react-i18next": ">=16 <17"
  }
}
